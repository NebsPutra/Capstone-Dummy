NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, only if you swap Leaflet/OSM for a keyed map provider
NEXT_PUBLIC_MAP_API_KEY=

# Complaint emails to the admin inbox (server-only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=

# PIN sign-in / PIN recovery (server-only secret; never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
